# ==============================================================================
# SKALA Industrial Weather Console - Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace with your actual API credentials:
# cp .env.example .env

# OpenWeatherMap API Key (Get yours at https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# OpenWeatherMap Base API Endpoints
VITE_OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
VITE_OPENWEATHER_GEO_URL=https://api.openweathermap.org/geo/1.0
VITE_OPENWEATHER_TILE_URL=https://tile.openweathermap.org/map
